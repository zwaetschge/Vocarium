# Vocarium configuration
# ---------------------------------------------------------------------------
# Copy this file to `.env` and adjust to your environment.
# Every setting has a sensible default; only override what you need.
# ---------------------------------------------------------------------------

# === Host port mappings ====================================================
# Public-facing UI (only port that needs to be reachable from outside)
VOCARIUM_UI_PORT=3100

# Gateway API. Expose only if you have an external client (e.g. Authelia
# reverse proxy or a sister app). Otherwise leave commented in compose.
VOCARIUM_API_PORT=8280
VOCARIUM_API_PORT_2=8281

# Internal service ports — only useful for direct debugging from the host.
# Set to empty in compose to keep them private to the voice-network.
TTS_PORT=8201
TTS_PORT_2=8202
ASR_PORT=8200
MUSIC_PORT=8203
SFX_PORT=8204

# === GPU layout ============================================================
# By default everything runs on GPU 0 (single-GPU mode). Idle-unload timeouts
# (below) ensure only one model is loaded at a time, so a single 12–16 GB
# GPU is enough.
GPU_TTS_1=0
GPU_ASR=0
GPU_MUSIC=0
GPU_SFX=0

# === Dual-GPU mode (optional) ==============================================
# Uncomment BOTH lines below to enable a second TTS replica on GPU 1 and
# move music/SFX to it. This unlocks parallel TTS and avoids music/SFX
# evicting TTS on shared hardware.
#
# COMPOSE_PROFILES=dual-gpu
# TTS_URL_2=http://qwen3-tts-2:8880
#
# Optional GPU index overrides for dual-GPU mode (defaults shown):
GPU_TTS_2=1
# Re-pin music/SFX to GPU 1 when running dual-GPU:
# GPU_MUSIC=1
# GPU_SFX=1

# === Idle timeouts (seconds) ===============================================
# How long to keep a model loaded after the last request before unloading
# to free VRAM. Set to 0 to keep loaded forever.
TTS_IDLE_TIMEOUT=120
ASR_IDLE_TIMEOUT=300
MUSIC_IDLE_TIMEOUT=600
SFX_IDLE_TIMEOUT=600

# === Authentication ========================================================
# Vocarium expects a `Remote-User` header (set by an upstream identity proxy
# like Authelia, oauth2-proxy, or Cloudflare Access).
#
# For local single-user setups, enable anonymous fallback so requests
# without the header are routed to a shared "api" user. Disable in any
# multi-user / public deployment.
ALLOW_ANONYMOUS=true

# Comma-separated list of allowed CORS origins for the browser UI.
# Use "*" only for local development. In production, list explicit origins:
#   CORS_ORIGINS=https://vocarium.example.com,https://reader.example.com
CORS_ORIGINS=*

# === Podcast Studio (optional) =============================================
# The Podcast Studio needs three external services. Leave blank to disable
# podcast features; the rest of Vocarium works without them.

# OpenAI-compatible chat completions endpoint (e.g. vLLM, llama.cpp, Ollama)
LLM_API_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TEMPERATURE=0.8
LLM_MAX_TOKENS=16384

# OpenAI-compatible embeddings endpoint
EMBEDDING_API_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=1024

# Docling document-extraction service (https://github.com/DS4SD/docling)
DOCLING_API_URL=

# === Model selection =======================================================
# Default Qwen3-TTS variant on container startup. Choices:
#   1.7b-base    — voice cloning from a reference recording
#   1.7b-design  — design a voice from a text description
#   1.7b-custom  — pick from 9 prebuilt speakers + emotion steering
DEFAULT_TTS_MODEL=1.7b-base

# Attention implementation. "eager" works on every GPU including Blackwell
# (RTX 50xx). Switch to "sdpa" only if you've tested it on your hardware.
TTS_ATTN_IMPL=eager

# === Misc ==================================================================
# HuggingFace cache directory on the host. Models are downloaded here and
# bind-mounted into containers; this avoids re-downloading on rebuild.
HF_CACHE_DIR=./models
