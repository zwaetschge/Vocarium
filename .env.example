# Vocarium configuration
# ---------------------------------------------------------------------------
# Copy this file to `.env` and adjust to your environment.
# Every setting has a sensible default; only override what you need.
# ---------------------------------------------------------------------------

# === Host port mappings ====================================================
# Public-facing UI (only port that needs to be reachable from outside)
VOCARIUM_UI_PORT=3100

# Gateway API. Expose only if you have an external client (e.g. Authelia
# reverse proxy or a sister app). Otherwise leave commented in compose.
VOCARIUM_API_PORT=8280
# Internal engine ports (kikiri/omnivoice/whisper) sit further down next to
# their engines; all of them bind to 127.0.0.1 only.

# === GPU layout ============================================================
# By default everything runs on GPU 0 (single-GPU mode). Idle-unload timeouts
# (below) ensure only one model is loaded at a time, so a single 12–16 GB
# GPU is enough.
GPU_TTS_1=0
# GPU_ASR steuert nur noch, gegen welche GPU die Queue den
# STT-Dienst (whisper-stt) verrechnet.
GPU_ASR=0
GPU_MUSIC=0

# === Emergency GPU fallback (historic) =====================================
# GPU 1 / RTX 5060 Ti is protected and reserved for the operator's own
# workloads. The dual-gpu profile shipped a second Qwen TTS replica; Qwen is
# retired, so there is nothing to enable here today.
#
# Optional fallback GPU index override (default shown):
GPU_TTS_2=1
# Music stays on the RTX 3060; do not re-pin it to GPU 1.

# === GPU resource guard =====================================================
# Vocarium asks gpu-task-manager before every queued GPU job. The guard blocks
# jobs mapped to protected GPU 1 when ComfyUI or unknown VRAM use is active.
GPUTASKS_URL=http://gpu-task-manager:3000
GPU_GUARD_ENABLED=true
GPU_GUARD_FAIL_OPEN=false
GPU_PROTECTED_IDS=1
GPU_PROTECTED_NAMES=5060
GPU_PROTECTED_PROCESS_PATTERNS=comfyui
GPU_PROTECTED_UNKNOWN_USED_MIB=1024
GPU_ESTIMATE_MIB_TTS=5500
GPU_GUARD_MEMORY_TOLERANCE_MIB_TTS=512
GPU_ESTIMATE_MIB_ASR=2100
GPU_ESTIMATE_MIB_MUSIC=8000
GPU_CUDA_OVERHEAD_MIB=500

# === Authentication ========================================================
# Vocarium expects a `Remote-User` header (set by an upstream identity proxy
# like Authelia, oauth2-proxy, or Cloudflare Access).
#
# For local single-user setups, enable anonymous fallback so requests
# without the header are routed to a shared "api" user. Disable in any
# multi-user / public deployment.
ALLOW_ANONYMOUS=true

# Comma-separated authenticated usernames allowed to run process-global admin
# actions such as model switching and destructive artifact cleanup.
VOCARIUM_ADMIN_USERS=api

# Comma-separated list of allowed CORS origins for the browser UI.
# Use "*" only for local development. In production, list explicit origins:
#   CORS_ORIGINS=https://vocarium.example.com,https://reader.example.com
CORS_ORIGINS=*

# === Podcast Studio (optional) =============================================
# The Podcast Studio needs three external services. Leave blank to disable
# podcast features; the rest of Vocarium works without them.

# OpenAI-compatible chat completions endpoint (e.g. vLLM, llama.cpp, Ollama)
LLM_API_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TEMPERATURE=0.8
LLM_MAX_TOKENS=16384
# User-configurable LLM endpoints are validated server-side to prevent SSRF.
# Keep private URLs blocked unless you explicitly own the target network.
LLM_ALLOW_PRIVATE_BASE_URLS=false
# Comma-separated exact hostnames allowed to resolve to private addresses
# when you intentionally use an internal OpenAI-compatible service.
LLM_ALLOWED_PRIVATE_HOSTS=
LLM_VALIDATE_BASE_URL_DNS=true

# Embeddings: local llama.cpp server (Compose service `embeddings`), CPU only.
# bge-m3 as GGUF -- multilingual, 1024 dimensions. Point these at any other
# OpenAI-compatible endpoint to use something else; leave EMBEDDING_API_URL
# empty and the service unstarted to disable semantic search / chapter split.
EMBEDDING_API_URL=http://embeddings:8080/v1
EMBEDDING_MODEL=bge-m3
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=1024
# Fetch with scripts/download-embedding-model.sh; lives in llama-embeddings/models/.
EMBEDDING_GGUF=bge-m3-Q8_0.gguf
EMBEDDING_PORT=8211
# CPU budget. bge-m3 scales near-linearly with threads: ~1.4 texts/s at 6,
# ~3.5 at 12, ~5.6 at 24 (600-char German paragraphs).
EMBEDDING_THREADS=16
EMBEDDING_CPUS=16
EMBEDDING_MEMORY_LIMIT=3g

# Docling document-extraction service (https://github.com/DS4SD/docling)
DOCLING_API_URL=

# Resolve podcast source URLs before handing them to Docling and reject private
# or loopback addresses. Keep true in production to prevent SSRF-style fetches.
PODCAST_VALIDATE_SOURCE_DNS=true
# Z.AI/Zhipu models think before answering; Vocarium disables that for podcast
# scripts (JSON output, minutes faster). Set true to keep the model's default.
LLM_ENABLE_THINKING=false

# --- Kikiri CPU voices & fine-tuning ----------------------------------------
# Kikiri serves fine-tuned German voices on CPU and is the default speech
# engine. Cloned voices are served by OmniVoice (below); Qwen, the historic
# catch-all, is retired.
DEFAULT_TTS_ENGINE=kikiri
KIKIRI_TTS_PORT=8205
KIKIRI_CPUS=12
KIKIRI_MEMORY_LIMIT=4g
KIKIRI_TORCH_THREADS=12
# Which published fine-tune answers when a request names no model.
KIKIRI_DEFAULT_MODEL=default-1
# Resident models in RAM; each costs roughly 350 MB.
KIKIRI_MAX_RESIDENT_MODELS=2

# The fine-tune trainer was removed (2026-08-30). Published voices in
# kikiri-tts/models/ keep working; there is no longer a way to train new ones
# from the WebUI. The kikiri-trainer/ directory is still on disk if you want to
# run it by hand.

# Qwen3-TTS: retired (2026-08-28). Its rows and reference audio stay in the
# database; set both of these to bring the engine back — and restore the
# qwen3-tts service in docker-compose.yml, which no longer exists.
TTS_URL=
QWEN_TTS_ENABLED=false

# OmniVoice: zero-shot cloning from a few seconds of reference audio, resident
# on GPU 0. Serves every cloned voice since the Qwen retirement.
OMNIVOICE_TTS_URL=http://omnivoice-tts:8880
OMNIVOICE_PORT=8208
OMNIVOICE_DEVICE=cuda
# HF cache for the OmniVoice weights (~6 GB). Point this at a persistent path.
OMNIVOICE_HF_CACHE=./omnivoice-api/cache
# Base image for the OmniVoice / Whisper builds. Both extend the shared
# gpu-base image (CUDA 13 + PyTorch), a build-only Compose service:
#   docker compose build gpu-base omnivoice-tts whisper-stt
OMNIVOICE_BASE_IMAGE=vocarium-gpu-base:latest

# Whisper STT: the only transcription service. Lazy, self-unloading after
# WHISPER_IDLE_TIMEOUT seconds. Serves profile "german" (vanilla large-v3) by
# default and "swiss" (the finetune below) on request — do not swap the
# default, the finetune silently translates some German audio to English.
WHISPER_URL=http://whisper-stt:8000
WHISPER_PORT=8210
WHISPER_IDLE_TIMEOUT=300
WHISPER_SWISS_MODEL=Flix-AI/flix-swissgerman-full
# Host directory for the HF + CTranslate2 caches (~11 GB once converted).
WHISPER_MODEL_DIR=./models
WHISPER_BASE_IMAGE=vocarium-gpu-base:latest

# --- Zugriff und Identität ----------------------------------------------------
# Nachweis, dass Remote-User vom Identity-Proxy stammt (vocarium-ui haengt den
# Header X-Vocarium-Proxy-Secret an). Leer = kein Nachweis verlangt.
VOCARIUM_PROXY_SECRET=
# Kommagetrennte Benutzernamen mit Admin-Rechten (leer = niemand).
VOCARIUM_ADMIN_USERS=
ALLOW_ANONYMOUS=false
CORS_ORIGINS=

# --- Hörspiele ----------------------------------------------------------------
PLEX_BASE_URL=http://plex:32400
# Token liegt in einer Datei ausserhalb des Repos; beide Pfade zeigen darauf.
PLEX_TOKEN_HOST_FILE=/mnt/user/appdata/vocarium/secrets/plex-token
PLEX_TOKEN_FILE=/run/secrets/plex-token
PLEX_LIBRARY_SECTION=
PLEX_MEDIA_HOST_ROOT=/mnt/user/Plex
PLEX_MEDIA_SERVER_ROOT=/data
PLEX_MEDIA_LOCAL_ROOT=/plex-media
# Vocarium-eigener Recherche-/Dramaturgie-Agent (Compose-Service hoerspiele-agent).
CODEX_AGENT_BASE_URL=http://hoerspiele-agent:8090
# Provider-Home und Zugangsdaten des Agenten (codex-home, claude-home,
# provider-secrets); gehört 1000:1000. Z.AI-Key über Hörspiele → Einstellungen → Zugänge.
VOCARIUM_AGENT_HOST_ROOT=/mnt/user/appdata/vocarium/agent
ZAI_API_KEY_HOST_FILE=/dev/null
CODEX_RESEARCH_TIMEOUT_SECONDS=1200
ASR_CHUNK_SECONDS=90
MAX_UPLOAD_BYTES=52428800

# --- Host paths ---------------------------------------------------------------
# Prefix for every bind-mount source in docker-compose.yml. Defaults to the
# compose project directory ("."). On Unraid point it at the /mnt/user share
# view, never at /mnt/cache: the mover relocates files and breaks the binds.
#VOCARIUM_HOST_ROOT=/mnt/user/AI/plum-code/voxtral
#WHISPER_MODEL_DIR=/mnt/user/AI/plum-code/voxtral/models
