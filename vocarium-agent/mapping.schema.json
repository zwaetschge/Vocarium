{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "series_title": { "type": "string" },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "chapter_id": { "type": "string" },
          "episode_ids": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "reasoning": { "type": "string" },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": { "type": "string" },
                "title": { "type": "string" },
                "claim": { "type": "string" }
              },
              "required": ["url", "title", "claim"],
              "additionalProperties": false
            }
          },
          "conflicts": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["chapter_id", "episode_ids", "confidence", "reasoning", "sources", "conflicts"],
        "additionalProperties": false
      }
    },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["series_title", "mappings", "notes"],
  "additionalProperties": false
}
