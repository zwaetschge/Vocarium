    <style name="Theme.Vocarium.Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="colorPrimary">#AEBEFF</item>
        <item name="colorAccent">#AEBEFF</item>
        <item name="colorControlActivated">#AEBEFF</item>
        <item name="colorControlNormal">#A9B4C8</item>
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:textColorPrimary">#F2F4FA</item>
        <item name="android:textColorSecondary">#A9B4C8</item>
